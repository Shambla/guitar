# Full paid MP3s — host via AWS/deploy; keep previews in git if small
web/WebContent/audio/fulldownloads/*.mp3
web/WebContent/audio/fulldownloads/**/*.mp3
!web/WebContent/audio/fulldownloads/.gitkeep
!web/WebContent/audio/fulldownloads/README.md
!web/WebContent/audio/fulldownloads/**/.gitkeep
!web/WebContent/audio/fulldownloads/**/README.md